# Gemini
GEMINI_API_KEY=
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview

# Signaling server (this service connects to it as a Socket.IO client)
SIGNALING_SERVER_URL=http://localhost:4000
# Must match JWT_SECRET in the signaling server's .env - used as a shared
# internal secret so the signaling server trusts this service's ai-register calls.
INTERNAL_SHARED_SECRET=change-this-to-a-long-random-string

# This service's own HTTP port (signaling server calls /session/start here)
PORT=8001
