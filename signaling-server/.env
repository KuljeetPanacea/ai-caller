# MongoDB
MONGO_URI=mongodb://localhost:27017/ai-caller

# JWT
JWT_SECRET=change-this-to-a-long-random-string

# Server
PORT=4000
CLIENT_ORIGIN=http://localhost:5173

# AI Voice Server (Python/FastAPI) - internal URL, used to tell it to start a session
AI_VOICE_SERVER_URL=http://localhost:8098

# Dev OTP mode: if true, OTP is always 123456 and just logged to console
# (swap this for Twilio Verify / MSG91 / etc. in production)
DEV_OTP_MODE=true
